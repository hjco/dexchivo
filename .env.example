# Copy to .env for local development. Never commit .env or real credentials.
# M1 is PAPER-only. LIVE settings must remain disabled.

# API runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
APP_VERSION=0.1.0
DASHBOARD_ORIGIN=http://localhost:3000
TRUST_PROXY=false
EXECUTION_MODE=PAPER
ENABLE_LIVE_TRADING=false

# Dashboard
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Chivo

# Python signal engine
CHIVO_EXECUTION_MODE=PAPER
CHIVO_ENABLE_LIVE_TRADING=false
CHIVO_HOST=0.0.0.0
CHIVO_PORT=8000
CHIVO_LOG_LEVEL=info
CHIVO_RELOAD=false
CHIVO_APP_VERSION=0.1.0

# Local PostgreSQL (Compose defaults are development-only)
POSTGRES_USER=chivo
POSTGRES_PASSWORD=chivo_local_dev_only
POSTGRES_DB=chivo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chivo:chivo_local_dev_only@localhost:5432/chivo?schema=public

# Local Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication (single admin)
# Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
AUTH_TOTP_ISSUER=Chivo

# Seeded administrator
ADMIN_EMAIL=admin@chivo.local
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrador

# Public market data (Binance USD-M Futures)
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE_URL=wss://fstream.binance.com/ws
BINANCE_REQUEST_TIMEOUT_MS=8000
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MARKET_SYNC_TTL_SECONDS=300
